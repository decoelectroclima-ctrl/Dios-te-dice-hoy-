<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <!-- Top Row: Badge + Citation + Sync Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:gravity="center"
            android:text="🕊️ DIOS TE DICE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_citation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Isaías 41:10"
            android:textColor="#6B1D2F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="↻ Sincronizar"
            android:textColor="#6B1D2F"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Verse Text -->
    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="«No temas, porque yo estoy contigo; no desmayes, porque yo soy tu Dios.»"
        android:textColor="#2A2A2A"
        android:textSize="11sp"
        android:textStyle="italic" />

    <!-- God Says Today -->
    <TextView
        android:id="@+id/widget_god_says"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="«Suelta tus cargas y descansa en mi abrazo de Padre.»"
        android:textColor="#6B1D2F"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
